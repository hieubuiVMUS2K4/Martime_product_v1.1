# Edge Server Environment Variables

# PostgreSQL Configuration
EDGE_POSTGRES_DB=maritime_edge
EDGE_POSTGRES_USER=edge_user
EDGE_POSTGRES_PASSWORD=REPLACE_WITH_EDGE_DB_PASSWORD
EDGE_POSTGRES_PORT=5433

# pgAdmin Configuration
EDGE_PGADMIN_EMAIL=admin@edge.local
EDGE_PGADMIN_PASSWORD=REPLACE_WITH_EDGE_PGADMIN_PASSWORD
EDGE_PGADMIN_PORT=5050

# Vessel Information
Vessel__IMO=9412378
Vessel__MMSI=574001201
Vessel__Name=MV TRUONG SA 01
Vessel__CallSign=XVTS1
Vessel__VesselType=Bulk Carrier
Vessel__DeadweightTonnage=58000
Vessel__BuiltYear=2018
Vessel__GrossTonnage=38500
Vessel__MainEnginePowerKW=9800

# Shore API
SHORE_API_URL=https://shcdvmu.site
SHORE_API_KEY=REPLACE_WITH_VALID_SHORE_API_KEY

# Internal-access / auth secrets
EDGE_INTERNAL_API_KEY=REPLACE_WITH_EDGE_INTERNAL_API_KEY
EDGE_AUTH_TOKEN_SIGNING_KEY=REPLACE_WITH_EDGE_TOKEN_SIGNING_KEY_MIN_32_CHARS

# Phase 2 secure sync
EDGE_SYNC_SECURITY_ENABLED=true
EDGE_SYNC_PROTOCOL_VERSION=2
EDGE_SYNC_NODE_ID=REPLACE_WITH_PROVISIONED_EDGE_NODE_ID
EDGE_SYNC_SIGNING_KEY=REPLACE_WITH_PROVISIONED_EDGE_SYNC_SIGNING_KEY
EDGE_SYNC_KEY_VERSION=1
