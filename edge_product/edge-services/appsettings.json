    "AutoMigrate": true,
    "RetentionDays": {
      "PositionData": 7,
      "AisData": 3,
      "EngineData": 30,
      "FuelConsumption": 90,
      "SafetyAlarms": 90,
      "EnvironmentalData": 7
    }
  },

  "SerialPorts": {
    "GPS": {
      "PortName": "COM1",
      "BaudRate": 4800,
      "Parity": "None",
      "DataBits": 8,
      "StopBits": "One",
      "Enabled": true
    },
    "AIS": {
      "PortName": "COM2",
      "BaudRate": 38400,
      "Parity": "None",
      "DataBits": 8,
      "StopBits": "One",
      "Enabled": true
    },
    "Gyro": {
      "PortName": "COM3",
      "BaudRate": 4800,
      "Parity": "None",
      "DataBits": 8,
      "StopBits": "One",
      "Enabled": false
    }
  },

  "Modbus": {
    "MainEngine": {
      "Type": "RTU",
      "PortName": "COM4",
      "BaudRate": 9600,
