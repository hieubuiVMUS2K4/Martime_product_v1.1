  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information", 
      "MaritimeEdge": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  
  "Vessel": {
    "IMO": "8765432",
    "MMSI": "574009876",
    "Name": "MV MEKONG SPIRIT",
    "CallSign": "3WXY8",
    "VesselType": "Bulk Carrier",
    "DeadweightTonnage": 65200,
    "BuiltYear": 2015,
    "GrossTonnage": 43000,
    "MainEnginePowerKW": 11060
