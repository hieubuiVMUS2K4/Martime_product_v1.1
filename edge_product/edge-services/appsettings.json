  },

  "ShoreAPI": {
    "BaseUrl": "http://localhost:5000",
    "ApiKey": "",
    "VesselId": "c207aae8-8388-47df-aa4d-271ae887bc25",
    "Timeout": 30,
    "Enabled": true
  },

  "Sync": {
    "BatchSize": 100,
    "SyncInterval": 30,
    "RetryAttempts": 5,
    "RetryDelaySeconds": 60,
    "RetryBaseSeconds": 2,
    "RetryCapSeconds": 300,
    "RetryJitterStrategy": "full",
    "RetryJitterMultiplier": 1.0,
    "ReconnectWarmupMaxSeconds": 120,
    "MaxInFlightBatches": 1,
    "RetryTokenBucket": {
      "RatePerSecond": 2.0,
      "Burst": 6
