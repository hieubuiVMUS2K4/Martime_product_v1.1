    "UseCompression": false,
    "CompressionMinSavingsRatio": 0.08,
    "CompressionMaxFileBytes": 1048576,
    "PreprocessImagesEnabled": true,
    "ImageMaxWidth": 1600,
    "ImageMaxHeight": 1600,
    "ImageJpegQuality": 82,
    "BundleSmallFilesEnabled": true,
    "BundleMinFileCount": 3,
    "BundleMaxFileBytes": 262144,
    "BundleMaxTotalBytes": 1048576,
    "DeltaSyncEnabled": true,
    "DeltaBlockSizeBytes": 262144,
    "HighPriorityInterval": 30,
    "MediumPriorityInterval": 120,
    "LowPriorityInterval": 300,
    "NetworkPushIntervalsSeconds": {
      "None": 60,
      "Satellite_Iridium": 45,
      "Satellite_VSAT": 30,
      "Cellular_4G": 15,
      "Shore_WiFi": 5,
      "Satellite_LEO": 2
    },
    "AdaptiveProfiles": {
      "Satellite_LEO": {
        "BatchSize": 300
      },
      "Satellite_VSAT": {
        "BatchSize": 100
      }
    },
    "NetworkType": "Shore_WiFi",
    "FileTransferChunkSizeBytes": 262144,
    "FileTransferChunkThresholdBytes": 1048576,
    "FileTransferAllowedPriorities": {
      "Satellite_Iridium": "Critical",
      "Satellite_VSAT": "Critical,Operational",
      "Satellite_LEO": "Critical,Operational,Low",
      "Cellular_4G": "Critical,Operational",
      "Shore_WiFi": "Critical,Operational,Low"
    }
  },

  "MQTT": {
    "BrokerUrl": "mqtt://localhost:1883",
    "Username": "maritime",
    "Password": "",
    "ClientId": "edge-collector",
    "Topics": {
      "Position": "vessel/{vesselId}/position",
      "Engine": "vessel/{vesselId}/engine",
      "Alarms": "vessel/{vesselId}/alarms",
      "Status": "vessel/{vesselId}/status"
