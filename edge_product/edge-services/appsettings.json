      "Registers": {
        "RPM": 0,
        "CoolantTemp": 1,
        "ExhaustTemp": 2,
        "LubeOilPressure": 3,
        "FuelPressure": 4,
        "RunningHours": 5
      }
    },
    "Generator1": {
      "Type": "TCP",
      "IpAddress": "192.168.1.100",
      "Port": 502,
      "SlaveAddress": 2,
      "Enabled": true,
      "Registers": {
        "Voltage": 0,
        "Frequency": 1,
        "Current": 2,
        "ActivePower": 3,
        "RunningHours": 4
      }
    }
  },

  "DataCollection": {
    "PositionInterval": 5,
