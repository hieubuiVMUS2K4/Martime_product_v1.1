  "Auth": {
    "TokenSigningKey": "Maritime_Edge_ISPS_Production_Key_Change_This_In_Deployment_2026_HMAC_SHA256_64chars"
  },

  "InternalAccess": {
    "ApiKey": ""
  },

  "Security": {
    "EnforceHttps": false,
    "RequireInternalAccess": false
