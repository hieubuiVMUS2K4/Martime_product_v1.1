  },

  "EngineSyncEnqueuer": {
    "Enabled": true,
    "IntervalSeconds": 10,
    "BatchSize": 100
  },

  "AlertSyncEnqueuer": {
    "Enabled": true,
    "IntervalSeconds": 10,
    "BatchSize": 50
  },

  "DataCleanup": {
    "Enabled": true,
    "CleanupHour": 2,
    "Comment": "Cleanup runs daily at CleanupHour (0-23). Uses Database:RetentionDays policies."
  }
