# Edge Server Environment Variables

# PostgreSQL Configuration
EDGE_POSTGRES_DB=maritime_edge
EDGE_POSTGRES_USER=edge_user
EDGE_POSTGRES_PASSWORD=ChangeMe_EdgePassword123!
EDGE_POSTGRES_PORT=5432
TZ=UTC

# pgAdmin Configuration
EDGE_PGADMIN_EMAIL=admin@edge.local
EDGE_PGADMIN_PASSWORD=ChangeMe_EdgePgAdmin123!
EDGE_PGADMIN_PORT=5050

# Vessel Information (production override - customize per vessel)
Vessel__IMO=1111111
Vessel__MMSI=367123456
Vessel__Name=dadada
Vessel__CallSign=XVTS1
Vessel__VesselType=General Cargo Ship
Vessel__DeadweightTonnage=58000
Vessel__BuiltYear=2018
Vessel__GrossTonnage=38500
Vessel__MainEnginePowerKW=9800

# Shore API
SHORE_API_URL=https://shcdvmu.site
SHORE_API_KEY=REPLACE_WITH_SHORE_API_KEY

# Internal-access / auth secrets
EDGE_INTERNAL_API_KEY=ChangeMe_EdgeInternalApiKey_ReplaceThis
EDGE_AUTH_TOKEN_SIGNING_KEY=ChangeMe_EdgeTokenSigningKey_UseAtLeast32Chars

# Phase 2 secure sync
EDGE_SYNC_SECURITY_ENABLED=false
EDGE_SYNC_PROTOCOL_VERSION=2
EDGE_SYNC_NODE_ID=1111111
EDGE_SYNC_SIGNING_KEY=
EDGE_SYNC_KEY_VERSION=1

# Database migration toggle for production backend startup.
# Baseline in 00-edge-dump.sql is aligned with current migration history.
# Keep true for convenience deployments (new migrations apply on startup).
EDGE_DATABASE_AUTO_MIGRATE=true
