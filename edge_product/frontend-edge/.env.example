# Edge Backend API Configuration
# Leave empty to use relative /api path (recommended for both dev and production)
# Vite dev server will proxy /api/* to the backend URL below
# In production, configure your reverse proxy (Nginx) to forward /api/* to the backend
VITE_API_URL=

# Backend URL for Vite dev proxy (only used during development)
# VITE_BACKEND_URL=http://localhost:5001

# Alternative: Use absolute URL if frontend and backend are on different domains
# VITE_API_URL=http://your-edge-server:5001/api

# WebSocket URL for real-time updates (future feature)
VITE_WS_URL=

# Vessel Information (Local Edge)
VITE_VESSEL_ID=EDGE_LOCAL
VITE_VESSEL_NAME=MV Test Vessel
VITE_IMO_NUMBER=1234567

# Development Server Port
VITE_PORT=3002
