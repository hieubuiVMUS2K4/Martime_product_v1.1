# ====================================
# DATABASE CONFIGURATION
# ====================================
# Main Backend Database (PostgreSQL)
POSTGRES_USER=product
POSTGRES_PASSWORD=CHANGE_ME_secure_password_here
POSTGRES_DB=productdb

# Edge Database (PostgreSQL)
EDGE_POSTGRES_DB=maritime_edge
EDGE_POSTGRES_USER=edge_user
EDGE_POSTGRES_PASSWORD=CHANGE_ME_secure_edge_password_here
EDGE_POSTGRES_PORT=5433

# ====================================
# PGADMIN CONFIGURATION
# ====================================
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=CHANGE_ME_pgadmin_password

# Edge PgAdmin
EDGE_PGADMIN_EMAIL=admin@edge.yourdomain.com
EDGE_PGADMIN_PASSWORD=CHANGE_ME_edge_pgadmin_password
EDGE_PGADMIN_PORT=5050

# ====================================
# JWT CONFIGURATION (min 32 chars)
# ====================================
JWT__Key=CHANGE_ME_generate_with_openssl_rand_base64_32
JWT__Issuer=product
JWT__Audience=product-users

# ====================================
# AUTH TOKEN SIGNING KEY (min 32 chars)
# ====================================
AUTH__TokenSigningKey=CHANGE_ME_generate_with_openssl_rand_base64_48

# ====================================
# MQTT CONFIGURATION
# ====================================
MQTT_PASSWORD=CHANGE_ME_mqtt_password

# ====================================
# REDIS CONFIGURATION
# ====================================
REDIS_URL=redis:6379

# ====================================
# API URLS
# ====================================
VITE_API_URL=http://localhost:5000
VITE_EDGE_API_URL=http://localhost:5001

# ====================================
# SHORE API (for Edge to Cloud sync)
# ====================================
SHORE_API_URL=http://backend:5000

# ====================================
# ENVIRONMENT
# ====================================
ASPNETCORE_ENVIRONMENT=Production
