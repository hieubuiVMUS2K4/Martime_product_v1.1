erDiagram

    %% =============================================
    %% CATALOG TABLES
    %% =============================================

    ranks {
        int id PK
        string rank_code
        string rank_name
        string department
        int sort_order
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    countries {
        int id PK
        string country_code
        string country_name
        boolean is_active
        string flag_image_url
        timestamp created_at
        timestamp updated_at
    }

    certificates {
        int id PK
        string certificate_code
        string certificate_name
        string category
        int validity_period_months
        boolean is_mandatory
        boolean is_active
        string issuing_authority
        string stcw_reference
        string description
        timestamp created_at
        timestamp updated_at
    }

    roles {
        int id PK
        string role_code
        string role_name
        string description
        boolean is_active
        timestamp created_at
    }

    %% =============================================
    %% CORE TABLE
    %% =============================================

    crew_members {
        uuid id PK
        string crew_id
        string full_name
        int rank_id FK
        int country_id FK
        string department
        string date_of_birth
        string blood_group
        timestamp join_date
        timestamp embark_date
        timestamp disembark_date
        boolean is_onboard
        string onboard_status
        string email_address
        string phone_number
        boolean is_synced
        bigint sync_version
        string origin_node
        timestamp created_at
        timestamp updated_at
    }

    %% =============================================
    %% CERTIFICATE MAPPING TABLES
    %% =============================================

    crew_certificates {
        int id PK
        uuid crew_member_id FK
        int certificate_id FK
        int country_id FK
        string certificate_number
        timestamp issue_date
        timestamp expiry_date
        string issuing_authority
        string status
        boolean is_synced
        bigint sync_version
        string origin_node
        timestamp created_at
        timestamp updated_at
    }

    rank_certificates {
        int id PK
        int rank_id FK
        int certificate_id FK
        timestamp created_at
        timestamp updated_at
    }

    country_certificates {
        int id PK
        int country_id FK
        int certificate_id FK
        timestamp created_at
        timestamp updated_at
    }

    %% =============================================
    %% DOCUMENT TABLES
    %% =============================================

    employment_documents {
        uuid id PK
        uuid crew_member_id FK
        int country_id FK
        string document_type
        string document_number
        timestamp issue_date
        timestamp expiry_date
        string file_url
        string notes
        timestamp created_at
        timestamp updated_at
    }

    seafarer_documents {
        uuid id PK
        uuid crew_member_id FK
        int country_id FK
        string document_type
        string document_number
        timestamp issue_date
        timestamp expiry_date
        string file_url
        string notes
        timestamp created_at
        timestamp updated_at
    }

    travel_documents {
        uuid id PK
        uuid crew_member_id FK
        int country_id FK
        string document_type
        string document_number
        timestamp issue_date
        timestamp expiry_date
        string file_url
        string notes
        timestamp created_at
        timestamp updated_at
    }

    health_documents {
        uuid id PK
        uuid crew_member_id FK
        string document_type
        string document_number
        timestamp issue_date
        timestamp expiry_date
        string file_url
        string notes
        timestamp created_at
        timestamp updated_at
    }

    %% =============================================
    %% SERVICE HISTORY
    %% =============================================

    service_records {
        uuid id PK
        uuid crew_member_id FK
        string vessel_name
        string vessel_flag
        string vessel_type
        numeric vessel_grt
        numeric vessel_dwt
        string rank_at_time
        timestamp boarding_date
        timestamp disembark_date
        string boarding_port_name
        string disembark_port_name
        boolean is_synced
        string origin_node
        timestamp created_at
        timestamp updated_at
    }

    %% =============================================
    %% VOYAGE CREW TABLES
    %% =============================================

    voyage_crew_assignments {
        uuid id PK
        uuid voyage_id FK
        uuid crew_member_id FK
        int rank_id FK
        string role
        string embark_port_name
        timestamp embark_date
        string disembark_port_name
        timestamp disembark_date
        string watch_schedule
        string status
        boolean is_synced
        string origin_node
        timestamp created_at
        timestamp updated_at
    }

    voyage_crew_change_plans {
        uuid id PK
        uuid voyage_id FK
        uuid plan_leg_id FK
        uuid crew_member_id FK
        int rank_id FK
        int sequence
        string change_type
        string port_name
        timestamp planned_date
        string replacement_reason
        boolean is_synced
        string origin_node
        timestamp created_at
        timestamp updated_at
    }

    %% =============================================
    %% AUTH TABLES
    %% =============================================

    users {
        bigint id PK
        string username
        string password_hash
        int role_id FK
        string crew_id
        boolean is_active
        boolean must_change_password
        int failed_login_attempts
        timestamp lockout_until
        timestamp last_login_at
        timestamp created_at
        timestamp updated_at
    }

    user_sessions {
        uuid id PK
        bigint user_id FK
        string access_token
        string refresh_token
        string ip_address
        string device_type
        timestamp login_at
        timestamp logout_at
        timestamp access_token_expires_at
        boolean is_active
        string termination_reason
    }

    %% =============================================
    %% RELATIONSHIPS
    %% =============================================

    %% Catalog -> crew_members
    ranks ||--o{ crew_members : "has rank"
    countries ||--o{ crew_members : "nationality"

    %% crew_members -> certificates
    crew_members ||--o{ crew_certificates : "owns"
    certificates ||--o{ crew_certificates : "type"
    countries ||--o{ crew_certificates : "issued by"

    %% Catalog certificate mapping
    ranks ||--o{ rank_certificates : "requires"
    certificates ||--o{ rank_certificates : "required for rank"
    countries ||--o{ country_certificates : "requires"
    certificates ||--o{ country_certificates : "required by country"

    %% crew_members -> documents
    crew_members ||--o{ employment_documents : "has"
    countries ||--o{ employment_documents : "issued by"
    crew_members ||--o{ seafarer_documents : "has"
    countries ||--o{ seafarer_documents : "issued by"
    crew_members ||--o{ travel_documents : "has"
    countries ||--o{ travel_documents : "issued by"
    crew_members ||--o{ health_documents : "has"

    %% crew_members -> service history
    crew_members ||--o{ service_records : "worked on"

    %% crew_members -> voyage
    crew_members ||--o{ voyage_crew_assignments : "assigned to"
    ranks ||--o{ voyage_crew_assignments : "rank on voyage"
    crew_members ||--o{ voyage_crew_change_plans : "planned change"
    ranks ||--o{ voyage_crew_change_plans : "rank on plan"

    %% Auth
    roles ||--o{ users : "has role"
    users ||--o{ user_sessions : "has session"
