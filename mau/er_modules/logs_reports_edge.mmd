erDiagram

    %% =============================================
    %% CATALOG
    %% =============================================

    report_types {
        int id PK
        string type_code
        string type_name
        string category
        string frequency
        boolean is_mandatory
        boolean requires_master_signature
        string regulation_reference
        boolean is_active
        timestamp created_at
    }

    %% =============================================
    %% MARITIME REPORTS (trung tâm)
    %% =============================================

    maritime_reports {
        uuid id PK
        string report_number
        int report_type_id FK
        uuid voyage_id FK
        uuid voyage_plan_leg_id FK
        timestamp report_date_time
        string status
        string prepared_by
        string master_signature
        boolean is_transmitted
        timestamp transmitted_at
        boolean is_synced
        string origin_node
        timestamp created_at
        timestamp updated_at
    }

    %% =============================================
    %% REPORT SUBTYPES
    %% =============================================

    departure_reports {
        uuid id PK
        uuid maritime_report_id FK
        uuid voyage_id FK
        string port_name
        timestamp departure_date_time
        string next_port
        timestamp estimated_time_of_arrival
        double distance_to_next_port
        double draft_forward
        double draft_aft
        double fuel_oil_rob
        double fresh_water_rob
        int crew_on_board
        string remarks
        timestamp created_at
    }

    arrival_reports {
        uuid id PK
        uuid maritime_report_id FK
        uuid voyage_id FK
        string port_name
        timestamp arrival_date_time
        double voyage_distance
        double average_speed
        double draft_forward
        double draft_aft
        double fuel_oil_rob
        double total_fuel_consumed
        int crew_on_board
        string remarks
        timestamp created_at
    }

    noon_reports {
        uuid id PK
        uuid maritime_report_id FK
        timestamp report_date
        double latitude
        double longitude
        double speed_over_ground
        double distance_traveled
        double distance_to_go
