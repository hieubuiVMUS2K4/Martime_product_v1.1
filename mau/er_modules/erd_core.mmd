erDiagram
    USERS {
        int id PK
        string username
        string password_hash
        int role_id FK
        string crew_id
        boolean is_active
        datetime last_login_at
        datetime created_at
        datetime updated_at
        int failed_login_attempts
        datetime lockout_until
        boolean must_change_password
        datetime password_changed_at
        string password_salt
    }
    ROLES {
        int id PK
        string name
        string description
    }
    USER_SESSIONS {
        string id PK
        string access_token
        string refresh_token
        int user_id FK
        string ip_address
        string user_agent
        string device_type
        datetime login_at
        datetime logout_at
        datetime access_token_expires_at
        datetime refresh_token_expires_at
        datetime last_activity_at
        boolean is_active
    }
    SYSTEM_LOGS {
        int id PK
        datetime timestamp
        string category
        string action
        string level
        string message
        int user_id
        string username
        string ip_address
        string entity_type
        string entity_id
        string old_values
        string new_values
        string result
        string session_id
    }
    __EFMIGRATIONSHISTORY {
        string MigrationId PK
        string ProductVersion
    }
    SYNC_QUEUE {
        int id PK
        string table_name
        string record_key
        int action_type
        string payload
        int priority
        int retry_count
        int max_retries
        datetime next_retry_at
        string last_error
        datetime created_at
        datetime synced_at
    }

    USERS ||--o{ USER_SESSIONS : "has"
    ROLES ||--o{ USERS : "assigned"
    USERS ||--o{ SYSTEM_LOGS : "author"
    USER_SESSIONS ||--o{ SYSTEM_LOGS : "session_logs"
