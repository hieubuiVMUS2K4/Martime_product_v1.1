erDiagram

    %% =============================================
    %% CATALOG
    %% =============================================

    ports {
        int id PK
        string port_code
        string port_name
        string country
        string country_code
        double latitude
        double longitude
        string time_zone
        boolean is_active
        boolean is_synced
        timestamp created_at
        timestamp updated_at
    }

    %% =============================================
    %% CORE TABLE
    %% =============================================

    voyage_records {
        uuid id PK
        string voyage_number
        string vessel_name
        string departure_port
        timestamp departure_time
        string arrival_port
        timestamp arrival_time
        double distance_traveled
        double fuel_consumed
        double average_speed
        string voyage_status
        string financial_status
        boolean is_synced
        string origin_node
        timestamp created_at
        timestamp updated_at
    }

    %% =============================================
    %% VOYAGE PLANNING
    %% =============================================

    voyage_plan_legs {
        uuid id PK
        uuid voyage_id FK
        int sequence
        string leg_type
        string from_port_code
        string to_port_code
        timestamp planned_departure_time
        timestamp planned_arrival_time
        double planned_distance
        double planned_duration_hours
        double planned_average_speed
        boolean crew_change_planned
        boolean bunker_supply_planned
        timestamp created_at
        timestamp updated_at
    }

    voyage_status_history {
        uuid id PK
        uuid voyage_id FK
        string from_status
        string to_status
        string changed_by
        timestamp changed_at
        string notes
        boolean is_synced
        string origin_node
        timestamp created_at
        timestamp updated_at
    }

    voyage_log_entries {
        uuid id PK
        uuid voyage_id FK
        uuid voyage_plan_leg_id FK
        string event_type
        timestamp event_date_time
        double latitude
        double longitude
        string port_name
        double speed_over_ground
        double total_voyage_distance
        string officer_on_watch
        string master_signature
        boolean is_synced
        string origin_node
        timestamp created_at
        timestamp updated_at
    }

    %% =============================================
    %% PORT CALLS
    %% =============================================

    port_calls {
        uuid id PK
        uuid voyage_id FK
        uuid voyage_plan_leg_id FK
        int port_id FK
        string port_code
        string port_name
        string call_type
        int sequence
        timestamp arrival_time
        timestamp departure_time
        boolean cargo_ops_completed
        string remarks
        boolean is_synced
        string origin_node
        timestamp created_at
        timestamp updated_at
    }

    %% =============================================
    %% CARGO
    %% =============================================

    voyage_cargo_plans {
        uuid id PK
        uuid voyage_id FK
        uuid plan_leg_id FK
        int sequence
        string operation_type
        string cargo_type
        double planned_quantity
        string unit
        string port_code
        string port_name
        boolean is_synced
        timestamp created_at
        timestamp updated_at
    }

    cargo_operations {
        uuid id PK
        uuid voyage_id FK
        uuid voyage_plan_leg_id FK
        string operation_type
        string cargo_type
        double quantity
        string unit
        string loading_port
        string discharge_port
        timestamp loaded_at
        timestamp discharged_at
        string bill_of_lading
        string status
        boolean is_synced
        string origin_node
        timestamp created_at
        timestamp updated_at
    }

    %% =============================================
    %% BUNKER & CREW PLANS
    %% =============================================

    voyage_bunker_plans {
        uuid id PK
        uuid voyage_id FK
        uuid plan_leg_id FK
        int sequence
        string fuel_type
        double planned_quantity
        string operation_type
        string port_code
        string port_name
        string supplier_name
        boolean is_synced
        timestamp created_at
        timestamp updated_at
    }

    voyage_crew_assignments {
        uuid id PK
        uuid voyage_id FK
        uuid crew_member_id FK
        int rank_id FK
        string role
        string embark_port_code
        timestamp embark_date
        string disembark_port_code
        timestamp disembark_date
        string status
        boolean is_synced
        string origin_node
        timestamp created_at
        timestamp updated_at
    }

    voyage_crew_change_plans {
        uuid id PK
        uuid voyage_id FK
        uuid plan_leg_id FK
        uuid crew_member_id FK
        int rank_id FK
        int sequence
        string change_type
        string port_name
        timestamp planned_date
        string replacement_reason
        boolean is_synced
        string origin_node
        timestamp created_at
        timestamp updated_at
    }

    %% =============================================
    %% FINANCE
    %% =============================================

    voyage_expense_requests {
        uuid id PK
        uuid voyage_id FK
        string request_number
        string cost_category
        double requested_amount
        string currency
        string vendor_name
        string port_name
        string status
        string requested_by
        string approved_by
        double approved_amount
        boolean is_synced
        string origin_node
        timestamp created_at
        timestamp updated_at
    }

    voyage_settlements {
        uuid id PK
        uuid voyage_id FK
        string settlement_number
        string status
        double total_expense_approved
        double total_advanced
        double total_disbursed
        double total_revenue
        double net_result
        double final_settlement_amount
        string prepared_by
        string approved_by
        timestamp approved_at
        boolean is_synced
        timestamp created_at
        timestamp updated_at
    }

