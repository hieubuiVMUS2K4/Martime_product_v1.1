# ─── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=product
POSTGRES_PASSWORD=Sh0re@Prod#2026!
POSTGRES_DB=productdb

# ─── JWT ───────────────────────────────────────────────────
JWT_KEY=3/aAFvYpNKAXKITMLlxJ8sdyUVi3DxhqLaz4l4FwJAKnNwl98G/q9vn4I4iOLH7S
JWT_ISSUER=product
JWT_AUDIENCE=product-users

# ─── Port expose ra ngoài ──────────────────────────────────
HTTP_PORT=80

# ─── pgAdmin (chỉ bật khi dùng profile tools) ─────────────
PGADMIN_EMAIL=admin@shore.local
PGADMIN_PASSWORD=PgAdmin@Shore2026!

# ─── Internal API Key (nginx → backend, không expose ra ngoài) ──
INTERNAL_API_KEY=4daa058a28c151118e24d80c974ca719e79e0911f1797c4c6de2669b80daa7f6

# ─── Security flags ────────────────────────────────────────────
# false = cho phép edge sync không cần key (edge chưa gửi X-Internal-Api-Key)
SECURITY_REQUIRE_INTERNAL_ACCESS=false
# false = chưa enable HMAC signing (cả 2 đầu đang Enabled=false)
SYNC_REQUIRE_SIGNED_REQUESTS=false
