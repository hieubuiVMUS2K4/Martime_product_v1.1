# =============================================================
# SHORE PRODUCTION ENVIRONMENT - .env.production
# Server: 27.71.17.165
# =============================================================

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=product
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=productdb

# ─── JWT ─────────────────────────────────────────────────────
# QUAN TRONG: phai la chuoi ngau nhien dai >= 32 ky tu
JWT_KEY=REPLACE_WITH_STRONG_JWT_KEY_MIN_32_CHARS

# ─── Internal reverse proxy access ───────────────────────────
INTERNAL_API_KEY=REPLACE_WITH_STRONG_INTERNAL_API_KEY

# ─── Security enforcement flags ─────────────────────────────
SECURITY_ENFORCE_HTTPS=true
SECURITY_REQUIRE_INTERNAL_ACCESS=true

# ─── Phase 2 secure sync ─────────────────────────────────────
SYNC_REQUIRE_SIGNED_REQUESTS=true
SYNC_PROTOCOL_VERSION=2

# ─── pgAdmin (optional - dùng profile tools) ────────────────
PGADMIN_EMAIL=admin@localhost.com
PGADMIN_PASSWORD=REPLACE_WITH_STRONG_PGADMIN_PASSWORD
