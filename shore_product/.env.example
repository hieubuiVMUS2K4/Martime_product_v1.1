# ====================================
# SHORE PRODUCT - ENVIRONMENT CONFIG
# ====================================

# Shore Database (PostgreSQL)
POSTGRES_USER=product
POSTGRES_PASSWORD=CHANGE_ME_secure_password_here
POSTGRES_DB=productdb

# PgAdmin (optional)
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=CHANGE_ME_pgadmin_password

# ====================================
# JWT CONFIGURATION
# ====================================
JWT__Key=CHANGE_ME_your_jwt_secret_key_min_32_chars
JWT__Issuer=product
JWT__Audience=product-users

# ====================================
# APPLICATION
# ====================================
ASPNETCORE_ENVIRONMENT=Development
INTERNAL_API_KEY=CHANGE_ME_local_internal_api_key_min_32_chars
DATA_PROTECTION__ENCRYPTION_KEY=CHANGE_ME_base64_32_byte_data_encryption_key
DATA_PROTECTION__CURRENTKEYVERSION=v1
DATA_PROTECTION__ENCRYPTIONKEYS__v1=CHANGE_ME_base64_32_byte_data_encryption_key

# ====================================
# PHASE 2 SECURE SYNC
# ====================================
SYNC_REQUIRE_SIGNED_REQUESTS=true
SYNC_PROTOCOL_VERSION=2
