# Edge Server Configuration Example
# Copy this file to .env and modify with your settings

# For local development (same machine)
EDGE_SERVER_URL=http://localhost:5001

# For LAN access (set your Edge Server IP)
# EDGE_SERVER_URL=http://192.168.1.81:5001

# For production/deployment
# EDGE_SERVER_URL=http://your-edge-server-ip:5001

# Connection Timeout (milliseconds)
CONNECTION_TIMEOUT=60000
RECEIVE_TIMEOUT=60000

# Cache Duration (hours)
CACHE_DURATION_HOURS=1
